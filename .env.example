VITE_API_BASE_URL=http://localhost:8012

# Cargo Load Operations: optional server-only aircraft drafting.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# UN Comtrade — Global Trade Data module (backend/comtrade/). Server-side
# only: never read by the frontend, never sent to the browser. Get a free
# key at https://comtradeapi.un.org/ (500 calls/day on the free tier;
# responses are cached indefinitely once fetched, see comtrade/client.py).
COMTRADE_API_KEY=

# Colombia product-name translation fallback, Tier 4 only (backend/translation/
# web_search.py) — reached only when Tier 3's local model can't produce a
# result. Free API key + Search Engine ID (cx) at
# https://programmablesearchengine.google.com/ (100 queries/day free tier).
# Server-side only. Leaving these unset just means Tier 4 has nothing to
# offer — it's not required for Tiers 1-3 to work.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Global Trade Data fallback chain, tier 3 (backend/trade_sources/fred_client.py)
# — US Census bilateral trade series, as republished by FRED. Reached only
# for a country UN Comtrade has no data for, once, when that country is
# first added to Commercial Structure (backend/trade_sources/discovery.py).
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html. Server-side
# only. Leaving this unset just means tier 3 reports "not configured" and
# the chain falls through to tier 1/2 (if registered) or none_found — it's
# never required and never blocks discovery.
FRED_API_KEY=

# Variety Gallery bootstrap (backend/species_gallery/langsearch_client.py) —
# one web search per genuinely new variety, to seed its `characteristics`
# fields. Free tier (up to 50 results/request, no credit card) but NOT
# keyless: get a real account + key at https://langsearch.com. Server-side
# only. Leaving this unset just means a bootstrap's characteristics/Tier A
# image step reports "not configured" and is skipped — it never blocks
# GBIF species resolution or Wikimedia Commons' Tier B image sourcing,
# neither of which needs a key at all.
LANGSEARCH_API_KEY=
