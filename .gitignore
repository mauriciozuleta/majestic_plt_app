# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated payroll import templates (per-company, regenerated on demand)
backend/payroll_templates/

# AI-researched country commercial profiles (generated on demand)
backend/country_profiles/
backend/competitiveness_analyses/

# AI-generated investor-facing risk plans (generated on demand)
backend/risk_plans/

# Company logo uploads are NOT gitignored, unlike the generated/regeneratable
# content above — these are irreplaceable user uploads (see persist_logo in
# routers/companies.py), same reasoning as majestic_plt.db itself being
# tracked: there's no "just build it again" for a logo someone else uploaded.

# Graphify knowledge-graph cache (regenerate with `graphify update .`)
graphify-out/

# Local secrets (API keys, etc.) — never committed
.env

# Knowledge-base retrieval indexes (rebuilt automatically from the stored files)
backend/documents/**/*.rag.json

# local embedding model (copied from prelim_training_tool; ~23 MB)
backend/knowledge_base/models/

# UN Comtrade's own HS classification reference, fetched once and cached
# (see backend/comtrade/classification.py) — ~2MB, regenerated automatically
backend/comtrade/hs_reference_cache.json

# UN Comtrade's own reporter-country reference, fetched once and cached
# (see backend/comtrade/countries.py) — regenerated automatically
backend/comtrade/reporters_cache.json

# Supermarket catalog exports downloaded by the Supermarket_data_fetch service
# (see backend/routers/supermarket_catalog.py) — their products are stored in
# the database; the files are kept locally as the download record
backend/supermarket_catalogs/

# RAG Files: per-country documents, their JSON conversions and baked RAG files
# (backend/rag_files, routers/rag_files.py) — user documents, kept on disk
backend/documents/rag_files/
