{
  "name": "majestic_software",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 5173 8012 || true",
    "dev:frontend": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:backend": "python -m uvicorn --app-dir . backend.main:app --reload --reload-dir backend --host 0.0.0.0 --port 8012",
    "dev": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@xyflow/react": "^12.11.5",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "kill-port": "^2.0.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
