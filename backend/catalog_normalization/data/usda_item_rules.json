{
 "_about": "Curated map from a product name (the module's lowercase key) to ONE USDA SR28 food and ONE of its household measures. First matching rule wins; `exclude` removes look-alikes. basis 'edible': the USDA portion is the edible part, so the weight as bought is grams / (1 - refuse%); basis 'as_sold': a whole natural unit (head, bunch, whole eggplant) taken as it is. Matching is by a person, never fuzzy: a product with no rule is not answered from USDA.",
 "rules": [
  {"match": "pineapple", "ndb": "09266", "portion": "^fruit$", "unit": "each", "basis": "edible"},
  {"match": "mango", "ndb": "09176", "portion": "fruit without refuse", "unit": "each", "basis": "edible"},
  {"match": "plantain", "ndb": "09277", "portion": "^medium", "unit": "each", "basis": "edible"},
